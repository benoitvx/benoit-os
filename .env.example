# Benoit OS — secrets (do not commit)
# Copy this file to .env and fill in real values, then run ./install.sh

# La Suite Docs MCP
# Where: https://docs.numerique.gouv.fr → browser cookie 'sessionid'
DOCS_SESSION_COOKIE=

# data.education.gouv.fr MCP (huwise.com gateway)
# Where: https://data.education.gouv.fr/api-keys
EDUCATION_DATA_API_KEY=

# Calendar iCal feed (read-only) — used by the `ingerer-transcripts` skill
# Where: any calendar that exposes a public-share .ics URL (OX App Suite, Google
# Calendar, iCloud, etc.). Optional CALDAV_USERNAME / CALDAV_PASSWORD if the
# feed requires basic auth.
CALDAV_ICS_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
